{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkbridge.local/schema/certification-evidence-bundle-v1.json",
  "title": "SparkBridge Certification Evidence Bundle",
  "type": "object",
  "required": ["format_version", "release", "protocol", "database_schema", "generated_unix_ms", "source_revision", "checks", "metrics"],
  "properties": {
    "format_version": {"const": 1},
    "release": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "database_schema": {"type": "integer", "minimum": 1},
    "generated_unix_ms": {"type": "integer", "minimum": 0},
    "bundle_id": {"type": ["string", "null"]},
    "source_revision": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "properties": {
        "runner": {"type": ["string", "null"]},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "inputs": {"type": "array"}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skip"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "sha256", "size_bytes"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "size_bytes": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
  },
  "additionalProperties": true
}
